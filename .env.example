# Emicarlo Souza Team Site — variáveis de ambiente obrigatórias
# Copie este arquivo como .env.local para desenvolvimento local.
# Configure estas variáveis no painel da Vercel antes do deploy.

# WhatsApp (com DDI + DDD, ex: 5511999999999)
NEXT_PUBLIC_WA_NUMBER=

# Instagram handle (sem @)
NEXT_PUBLIC_INSTAGRAM_HANDLE=

# E-mail de destino para o formulário de contato
CONTACT_EMAIL=

# Resend API Key — https://resend.com (necessário para envio de e-mails)
RESEND_API_KEY=
